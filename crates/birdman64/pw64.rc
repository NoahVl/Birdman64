// Windows resource for the Birdman64 exe: app icon + version metadata.
// Embedded by crates/birdman64/build.rs via embed-resource on windows targets
// only; the VER_* macros come from CARGO_PKG_VERSION in build.rs.
//
// The icon is the lowest-numbered icon resource (Explorer uses it). The
// version strings need the two-level stringize trick: rc does not expand
// plain macros inside quoted strings.
#include <winver.h>

#define VER_STR2(x) #x
#define VER_STR(x)  VER_STR2(x)

1 ICON "../../assets/icon/birdman64.ico"

1 VERSIONINFO
FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Birdman64 contributors"
      VALUE "FileDescription",  "Birdman64"
      VALUE "FileVersion",      VER_STR(VER_VERSION)
      VALUE "InternalName",     "birdman64"
      VALUE "LegalCopyright",   "MIT licence; not affiliated with Nintendo"
      VALUE "OriginalFilename", "Birdman64.exe"
      VALUE "ProductName",      "Birdman64"
      VALUE "ProductVersion",   VER_STR(VER_VERSION)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
