+// PW64 split-screen (pw64_native.h "sound events"): owning player + 1 per
+// callback slot, 0 = shared (snd.c, env_sound.c). A vehicle sound handler
+// (its event list has 0x16, which no world handler takes) belongs to the
+// player live at registration. A post made in player i's scope reaches
+// only player i's handlers; an unscoped post reaches every handler (a
+// muted player's only for teardown-type events). An owned handler runs
+// with its player live and in its scope, so what it posts (a crash's 0x12)
+// stays with that player.
+static u8 sPw64UserOwner[36][4]; // events up to 35 index past D_8025BF00[30]
+static u8 sPw64SysOwner[ARRAY_COUNT(D_8025C3F0)][10];
+int pw64_evt_scope = -1;
+unsigned int pw64_evt_mute;
+
+static void pw64_evt_call(EventCallbackInfo* e, u8 owner, s32 scope, s32 event, s32 data) {
+    s32 p = owner - 1;
+    s32 prevCur;
+    s32 prevScope;
+
+    if (pw64_level_players < 2) {
+        e->cb(event, e->arg, data);
+        return;
+    }
+    if (owner == 0) {
+        if (scope < 0) {
+            e->cb(event, e->arg, data);
+        }
+        return;
+    }
+    // Muted: no frame update, crash check or unmute; teardown (0xD) still runs.
+    if ((p >= pw64_level_players) || ((scope >= 0) && (scope != p)) ||
+        ((pw64_evt_mute & (1u << p)) && ((event == 1) || (event == 0x13) || (event == 0x16)))) {
+        return;
+    }
+    prevCur = pw64_player_cur;
+    prevScope = pw64_evt_scope;
+    pw64_player_switch(p);
+    pw64_evt_scope = p;
+    e->cb(event, e->arg, data);
+    pw64_evt_scope = prevScope;
+    pw64_player_switch(prevCur);
+}
+
+void pw64_evt_post_player(int i, int event) {
+    s32 prevScope = pw64_evt_scope;
+
+    pw64_evt_scope = i;
+    uvEventPost(event, 0);
+    pw64_evt_scope = prevScope;
+}
