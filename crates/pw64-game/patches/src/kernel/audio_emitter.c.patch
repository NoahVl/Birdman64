+// PW64 split-screen (pw64_native.h): further players' listener poses
+// (player 1's is D_80250E80[0], set by snd.c). A positional emitter is
+// heard as from the nearest listener (distance and pan), so each player
+// hears what is near them; vehicle engines are not positional.
+static Mtx4F sPw64Listener[PW64_MAX_PLAYERS];
+
+void pw64_listener_set(int i, void* mat) {
+    if ((i > 0) && (i < PW64_MAX_PLAYERS)) {
+        uvMat4Copy(&sPw64Listener[i], (Mtx4F*)mat);
+    }
+}
+
+// uvEmitter_80201D08's squared distance from listener `l` (its 2/default
+// branches) and the vector its pan is projected from.
+static f32 pw64_emitter_dist(uvaEmitter_t* emitter, s32 attr, Mtx4F* l, Vec3F* d) {
+    Vec3F p;
+    Vec3F n;
+    f32 t;
+
+    p.x = l->m[3][0];
+    p.y = l->m[3][1];
+    p.z = l->m[3][2];
+    if (attr & 2) {
+        d->x = p.x - emitter->unk40.x;
+        d->y = p.y - emitter->unk40.y;
+        d->z = p.z - emitter->unk40.z;
+        if (uvVec3Dot(d, &emitter->unk58) >= 0.0f) {
+            n.x = -emitter->unk58.x;
+            n.y = -emitter->unk58.y;
+            n.z = -emitter->unk58.z;
+            d->x = p.x - emitter->unk4C.x;
+            d->y = p.y - emitter->unk4C.y;
+            d->z = p.z - emitter->unk4C.z;
+            t = uvVec3Dot(d, &n);
+            if (t >= 0.0f) {
+                d->x = p.x - ((t * n.x) + emitter->unk4C.x);
+                d->y = p.y - ((t * n.y) + emitter->unk4C.y);
+                d->z = p.z - ((t * n.z) + emitter->unk4C.z);
+            }
+        }
+    } else {
+        d->x = emitter->m1.m[3][0] - p.x;
+        d->y = emitter->m1.m[3][1] - p.y;
+        d->z = emitter->m1.m[3][2] - p.z;
+    }
+    return SQ(d->x) + SQ(d->y) + SQ(d->z);
+}
