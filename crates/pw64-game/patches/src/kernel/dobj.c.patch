+// PW64 split-screen (pw64_native.h): owning player + 1 per dobj, 0 =
+// shared. Only per-player objectives are owned (pw64_dobj_claim/clone);
+// a dobj owned by another player is neither drawn nor collided with.
+// Freeing a dobj (model 0xFFFF) makes it shared again.
+u8 pw64_dobj_owner[100];
+// Player + 1 whose cockpit (first-person) view hid this dobj, 0 = none: it
+// still draws in the other players' views. Set and cleared by the vehicle
+// (not by uvDobjState: the camera's collision probes toggle the state and
+// restore it every pass).
+u8 pw64_dobj_cockpit[100];
+// Player + 1 whose first-person view put this dobj on the near list (state
+// bit 4: own frustum after a z clear) and hid the part bits in
+// pw64_dobj_near_parts (pilot); other views draw it normally, parts shown.
+u8 pw64_dobj_near[100];
+u32 pw64_dobj_near_parts[100];
+
+void pw64_dobj_near_set(s32 objId, s32 on, u32 parts) {
+    if (objId < 100) {
+        pw64_dobj_near[objId] = on ? (u8)(pw64_player_cur + 1) : 0;
+        pw64_dobj_near_parts[objId] = on ? parts : 0;
+    }
+}
+
+void pw64_dobj_claim(s32 objId) {
+    if ((pw64_level_players > 1) && (objId < 100) && (D_80263780[objId].modelId != 0xFFFF)) {
+        pw64_dobj_owner[objId] = (u8)(pw64_player_cur + 1);
+    }
+}
+
+// PW64 split-screen: a copy of dobj `src` (model, state, props, part
+// transforms) owned by the current player; `src` keeps (or gets) player
+// 1 as owner. 0xFFFF when `src` is free or no dobj is left.
+s32 pw64_dobj_clone(s32 src) {
+    Unk80263780* s;
+    Unk80263780* d;
+    s32 id;
+    s32 i;
+    s32 n;
+
+    if ((src >= 100) || (D_80263780[src].modelId == 0xFFFF)) {
+        return 0xFFFF;
+    }
+    id = uvDobjAllocIdx();
+    if (id == 0xFFFF) {
+        PW64_LOGF("split-screen: no free dobj to clone, src", src);
+        return 0xFFFF;
+    }
+    s = &D_80263780[src];
+    d = &D_80263780[id];
+    uvDobjModel(id, s->modelId);
+    if (d->modelId == 0xFFFF) {
+        return 0xFFFF;
+    }
+    n = gGfxUnkPtrs->models[s->modelId]->mtxCount;
+    for (i = 0; i < n; i++) {
+        uvMat4Copy(&D_80265080[d->unk2[i]], &D_80265080[s->unk2[i]]);
+    }
+    uvDobjState(id, s->unk34);
+    d->unk38 = s->unk38;
+    d->unk3C = s->unk3C;
+    if (pw64_dobj_owner[src] == 0) {
+        pw64_dobj_owner[src] = 1;
+    }
+    pw64_dobj_owner[id] = (u8)(pw64_player_cur + 1);
+    return id;
+}
