+// PW64 split-screen: per-player part of the test setup for players 2..n
+// (hang glider / gyrocopter / rocket belt / jumble hopper / birdman), after player 1's. Each player i: kernel
+// channel i = camera i in its viewport, own vehicle buffer + results
+// struct, pad i. Each player's HUD is drawn by its channel's callback and
+// laid out in its view by the renderer (pw64_hud_split_tag).
+static void pw64_setup_players(Unk80362690* arg0) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    HangGliderData* hg;
+    GyrocopterData* gc;
+    RocketBeltData* rb;
+    JumbleHopperData* jh;
