+// PW64 split-screen: gameUpdateStateTestUpdate's time checks, per player
+// still flying: the "land now" time despawns that player's objectives, the
+// time limit finishes them. Results once every player is done.
+static s32 pw64_test_time_split(Unk80362690* arg0, s32 gameState) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    f32 landNow;
+    f32 timeUp;
+    s32 chime = FALSE;
+    s32 i;
+
+    taskGet_80345CC0(&landNow, &timeUp);
+    for (i = 0; i < pw64_level_players; i++) {
+        if (sPw64Done[i]) {
+            continue;
+        }
+        pw64_player_switch(i);
+        if ((landNow > 0.0f) && (landNow < D_8034F850) && (arg0->unkA0 != 0) && (p->unkA != 3) && (p->unkA != 4)) {
+            hudText_8031D8E0(TEXT_LAND_MOW, 1.5f, 8.0f);
+            chime = TRUE;
+            if (i == 0) {
+                taskDeinit();
+            } else {
+                pw64_task_deinit_player();
+            }
+            arg0->unkA0 = 0;
+        }
+        if ((timeUp > 0.0f) && (timeUp < D_8034F850)) {
+            arg0->unkA1 = 1;
+            pw64_player_finish(arg0, i);
+        }
+    }
+    pw64_player_switch(0);
+    if (chime) {
+        sndPlaySfx(SFX_UI_HUD_CHIME);
+    }
+    return pw64_all_finished() ? GAME_STATE_RESULTS : gameState;
+}
