+// Once per frame after every player's vehicle update (player 0 live).
+static void pw64_collide_frame(void) {
+    s32 veh = D_80362690->unkC[0].veh; // every player flies the same vehicle
+    Mtx4F* a;
+    Mtx4F* b;
+    f32 dx;
+    f32 dy;
+    f32 dz;
+    f32 r;
+    s32 i;
+
+    if (!sPw64Collide || (pw64_level_players != 2) || (veh == VEHICLE_SKY_DIVING)) {
+        return;
+    }
+    for (i = 0; (veh == VEHICLE_JUMBLE_HOPPER) && (i < 2); i++) {
+        if (!sPw64JhBump[i]) {
+            continue;
+        }
+        pw64_player_switch(i);
+        pw64_evt_scope = i;
+        if (sPw64Done[i] || (sPw64Respawn[i] != 0.0f) || (((JumbleHopperData*)D_80362748[i])->unk4C >= 6) ||
+            pw64_jh_fall((JumbleHopperData*)D_80362748[i])) {
+            sPw64JhBump[i] = FALSE; // landed (or fell over by itself)
+        }
+        pw64_evt_scope = -1;
+        pw64_player_switch(0);
+    }
+    for (i = 0; i < 2; i++) {
+        if (sPw64Done[i] || (sPw64Respawn[i] != 0.0f) || sPw64JhBump[i] || !pw64_collide_live(veh, D_80362748[i])) {
+            return;
+        }
+    }
+    a = pw64_collide_mtx(veh, D_80362748[0]);
+    b = pw64_collide_mtx(veh, D_80362748[1]);
+    dx = a->m[3][0] - b->m[3][0];
+    dy = a->m[3][1] - b->m[3][1];
+    dz = a->m[3][2] - b->m[3][2];
+    r = 2.0f * pw64_collide_radius(veh);
+    if ((SQ(dx) + SQ(dy) + SQ(dz)) >= SQ(r)) {
+        return;
+    }
+    for (i = 0; i < 2; i++) {
+        pw64_player_switch(i);
+        pw64_evt_scope = i;
+        pw64_collide_crash(veh, D_80362690->unkC[0].vehicleData);
+    }
+    pw64_evt_scope = -1;
+    pw64_player_switch(0);
+    PW64_LOGF("split-screen: pilots collided (time*10 << 8 | veh)", ((u32)(D_8034F850 * 10.0f) << 8) | veh);
+}
