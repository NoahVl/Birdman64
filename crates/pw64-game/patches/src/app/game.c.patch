+static s32 sPw64Collide;
+static u8 sPw64JhBump[PW64_MAX_PLAYERS]; // hopper hit in the air: falls over on landing
+
+// Sphere radius (m) around the vehicle's origin: about half the span.
+static f32 pw64_collide_radius(s32 veh) {
+    switch (veh) {
+    case VEHICLE_HANG_GLIDER:
+        return 4.0f; // ~9 m wing
+    case VEHICLE_GYROCOPTER:
+        return 3.0f; // rotor disc
+    case VEHICLE_BIRDMAN:
+        return 2.5f; // ~5 m wings
+    default:
+        return 1.0f; // rocket belt / jumble hopper: one pilot
+    }
+}
+
+static Mtx4F* pw64_collide_mtx(s32 veh, void* data) {
+    switch (veh) {
+    case VEHICLE_GYROCOPTER:
+        return &((GyrocopterData*)data)->unk10;
+    case VEHICLE_ROCKET_BELT:
+        return &((RocketBeltData*)data)->unk10;
+    case VEHICLE_JUMBLE_HOPPER:
+        return &((JumbleHopperData*)data)->unk74;
+    case VEHICLE_BIRDMAN:
+        return &((BirdmanData*)data)->unk10;
+    default:
+        return &((HangGliderData*)data)->unk10;
+    }
+}
+
+// Flying or on the ground, not already tumbling/crashed/landed.
+static s32 pw64_collide_live(s32 veh, void* data) {
+    switch (veh) {
+    case VEHICLE_GYROCOPTER:
+        return ((GyrocopterData*)data)->unkC0 <= 1;
+    case VEHICLE_ROCKET_BELT:
+        return ((RocketBeltData*)data)->unk90 <= 1;
+    case VEHICLE_JUMBLE_HOPPER:
+        return ((JumbleHopperData*)data)->unk4C <= 5; // 6..9: fallen over, getting up
+    case VEHICLE_BIRDMAN:
+        return ((BirdmanData*)data)->unk104 == 0;
+    default:
+        return ((HangGliderData*)data)->unk8C <= 1;
+    }
+}
+
+// The jumble hopper falls over (state 6, func_80301D28) at its last ground
+// contact unk134, which only the landing queries set: before the first
+// landing it is the origin (the hopper got stuck far from its camera in
+// state 9 until the 7 s timeout, or faulted), mid-hop it is the previous
+// landing spot. So it falls over only from the ground (crouch, take-off,
+// landing: states 0, 1, 3), at its own spot on the ground under it (unk68,
+// set at the start and by every landing); a hopper hit in the air falls
+// over when it lands.
+static s32 pw64_jh_fall(JumbleHopperData* jh) {
+    if ((jh->unk4C != 0) && (jh->unk4C != 1) && (jh->unk4C != 3)) {
+        return FALSE;
+    }
+    jh->unk134.x = jh->unkF4.x;
+    jh->unk134.y = jh->unkF4.y;
+    jh->unk134.z = jh->unk68;
+    jh->unk4C = 6;
+    sndPlaySfx(SFX_CRASH_LANDING_REVEAL);
+    return TRUE;
+}
+
+// The live player's vehicle takes its own hard-impact state; its movement,
+// sound and status code run the rest (test end / free-flight respawn).
+static void pw64_collide_crash(s32 veh, void* data) {
+    HangGliderData* hg;
+    GyrocopterData* gc;
+    RocketBeltData* rb;
+    BirdmanData* bm;
+
+    switch (veh) {
+    case VEHICLE_GYROCOPTER: // func_8030877C: hard hit
+        gc = data;
+        gc->unk96 = smokeCreate();
+        smokeProps(gc->unk96, SMOKE_PROP_1(0, 0, 0), SMOKE_PROP_2(20.0f), SMOKE_PROP_3(2.0f), SMOKE_PROP_5(0.0f, 0.0f, 0.0f), SMOKE_PROP_END);
+        gc->unkC0 = 2;
+        break;
+    case VEHICLE_ROCKET_BELT: // func_8032975C: impact over 21.8 m/s
+        rb = data;
+        rb->unk90 = 2;
+        rb->unk91 = 0;
+        rb->unk4 &= ~4;
+        rb->unk114 = 1000.0f;
+        rb->unk118 = 1000.0f;
+        break;
+    case VEHICLE_JUMBLE_HOPPER: // func_803006E8: bad landing, falls over
+        if (!pw64_jh_fall(data)) {
+            sPw64JhBump[pw64_player_cur] = TRUE;
+        }
+        break;
+    case VEHICLE_BIRDMAN: // bird_802D0080: object hit
+        bm = data;
+        bm->unk106 = 1;
+        bm->unk104 = 1;
+        bm->unk4 = (bm->unkE0 != 0) ? 0xF7FB : 0xF7F8; // 0xF7F8 = D_8035963C
+        break;
+    default: // hangGlider_802F3A80: object hit at speed
+        hg = data;
+        hg->unk8D = 1;
+        hg->unk8C = 2;
+        hg->unk4 = (hg->unk5C != 0) ? 0xF7FB : 0xF7F8; // 0xF7F8 = D_8036830C
+        break;
+    }
+}
