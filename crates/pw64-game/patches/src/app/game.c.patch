+    Mtx4F start;
+    Mtx4F* vehMtx;
+    s32 i;
+    f32 landNow;
+    f32 timeUp;
+
+    for (i = 1; i < pw64_level_players; i++) {
+        pw64_player_switch(i);
+        p->unk70 = &D_80362E88[i];
+        p->unk74 = &D_80364210[i];
+        p->vehicleData = D_80362748[i];
+        func_8034B5E0(i, p->unk70);
+        uvChanTerra(i, arg0->terraId);
+        uvChanEnv(i, arg0->envId);
+        pw64_split_viewport(p->unk70, i);
+        if (p->veh == VEHICLE_GYROCOPTER) {
+            D_803676F4 = gc = (GyrocopterData*)p->vehicleData;
+            gyrocopterLoadLevel(i, p->pilot, gc, p->unk70);
+            gyrocopterEnterLeave(gc);
+            vehMtx = &gc->unk10;
+        } else if (p->veh == VEHICLE_ROCKET_BELT) {
+            D_803676F8 = rb = (RocketBeltData*)p->vehicleData;
+            rocketBeltLoadLevel(i, p->pilot, rb, p->unk70);
+            rocketBeltEnterLeave(rb);
+            vehMtx = &rb->unk10;
+        } else if (p->veh == VEHICLE_JUMBLE_HOPPER) {
+            D_80367708 = jh = (JumbleHopperData*)p->vehicleData;
+            jumbleHopperLoadLevel(i, p->pilot, jh, p->unk70);
+            jumbleHopperEnterLeave(jh);
+            vehMtx = &jh->unk74;
+        } else if (p->veh == VEHICLE_BIRDMAN) {
+            D_80367704 = bm = (BirdmanData*)p->vehicleData;
+            birdLoadLevel(i, p->pilot, bm, p->unk70);
+            birdEnterLeave(bm);
+            vehMtx = &bm->unk10;
