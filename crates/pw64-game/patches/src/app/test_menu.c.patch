 #endif
+
+// PW64 free flight: drawn like the sprite buttons (64x18 at x 206, y 28..46,
+// N64 y up): the sprites' grey face with a light top/left and a two-step
+// dark bottom/right bevel (colours measured off the ROM buttons), bold
+// text (pw64_text.c) with the sprites' grey drop shadow, scaled to fit.
+// Text is queued here and flushed by testMenuDraw's uvFontGenDlist.
+static void pw64_free_draw_button(void) {
+    s32 x0 = SPRITE_PROP_POS_X2;
+    s32 x1 = SPRITE_PROP_POS_X2 + SPRITE_PROP_DIM_X;
+    s32 w;
+    s32 h;
+    s32 tx;
+    s32 ty;
+    f32 scale;
+
+    uvGfxStatePush();
+    uvGfxSetFlags(GFX_STATE_XLU | GFX_STATE_TEXTURE_NONE);
+    uvGfxClearFlags(GFX_STATE_AA | GFX_STATE_ZBUFFER | GFX_STATE_CULL_BACK);
+    screenDrawBox(x0, 28, x1, 46, 0x52, 0x52, 0x52, 0xFF);         // outer shadow line
+    screenDrawBox(x0, 29, x1 - 1, 46, 0x73, 0x73, 0x73, 0xFF);     // bottom/right bevel
+    screenDrawBox(x0, 30, x1 - 2, 46, 0xCE, 0xCE, 0xCE, 0xFF);     // top/left highlight
+    screenDrawBox(x0 + 1, 30, x1 - 2, 45, 0x94, 0x94, 0x94, 0xFF); // face
+    uvGfxStatePop();
+    if (sPw64FreeText[0] == 0) {
+        pw64_text_encode_style("Free flight", sPw64FreeText, ARRAY_COUNT(sPw64FreeText), TRUE);
+    }
+    uvFontSet(6);
+    uvFontScale(1.0, 1.0);
+    w = uvFontStr16Width(sPw64FreeText);
+    scale = (w > SPRITE_PROP_DIM_X - 6) ? (f32)(SPRITE_PROP_DIM_X - 6) / w : 1.0f;
+    uvFontScale(scale, 0.7);
+    w = uvFontStr16Width(sPw64FreeText);
+    h = uvFontHeight();
+    // Centred by eye against the sprites: the width includes trailing
+    // spacing, and the font's height its descender room.
+    tx = x0 + (SPRITE_PROP_DIM_X - 1 - w) / 2 + 3;
+    ty = 29 + (14 - h) / 2;
+    uvFontColor(0x6B, 0x6B, 0x6B, 0xFF); // shadow, down-right as on the sprites
+    uvFontPrintStr16(tx + 1, ty - 1, sPw64FreeText, 0xFF, 0xFFE);
+    uvFontColor(0x00, 0x00, 0x00, 0xFF);
+    uvFontPrintStr16(tx, ty, sPw64FreeText, 0xFF, 0xFFE);
+}
