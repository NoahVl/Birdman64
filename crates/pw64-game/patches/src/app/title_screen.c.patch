+            D_80378CE4 = 0.0f; // restart the attract-demo idle timer
+            break;
@@ -483,1 +494,4 @@
-    screenDrawBox(97, 76, 202, 118, 0, 0, 0, sp30);
+    screenDrawBox(97, 76 - sPw64MenuDy, 202, 118, 0, 0, 0, sp30); // PW64: + Players row
+    pw64_title_hint_box();
