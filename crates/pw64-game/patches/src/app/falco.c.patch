+    PW64_REG(D_8035AF48);
+    PW64_REG(D_8035AF4C);
+    PW64_REG(D_8035AF50);
+    PW64_REG(D_8035AF54);
+    PW64_REG(D_8035AF58);
+}
+
+// PW64 split-screen: player i's own dobjs for the hawk (its three models)
+// and any rock in flight; the radar waypoints are already in
+// its own HUD copy (pw64_players_sync).
+void pw64_falco_clone(void) {
+    Falco* f;
+    s32 i;
+
+    for (i = 0; i < D_8035A5F0; i++) {
+        f = &sFalcos[i];
+        if (f->unk0 != 0xFFFF) {
+            f->unk0 = pw64_dobj_clone(f->unk0);
+            f->unk4 = pw64_dobj_clone(f->unk4);
+            f->unk8 = pw64_dobj_clone(f->unk8);
+        }
+    }
+    for (i = 0; i < D_8035A918; i++) {
+        if (D_8035A920[i].unk0 != 0xFFFF) {
+            D_8035A920[i].unk0 = pw64_dobj_clone(D_8035A920[i].unk0);
+        }
+    }
+}
