+// PW64 split-screen (task.c.patch pw64_reg_task): every player has its own
+// hawk and rocks, like the other objectives: it chases and attacks that
+// player (unkC[0] = the live player), only that player's missiles hit it
+// (owned dobjs) and its hits score for that player (falco_802E5818 at the
+// finish). pw64_task_world_update ticks each player's copy with it live.
+// D_8035AF30..3C are set from unk244 each call; 40..58 are smoothed.
+void pw64_reg_falco(void) {
+    PW64_REG(sFalcos);
+    PW64_REG(D_8035A5F0);
+    PW64_REG(D_8035A918);
+    PW64_REG(D_8035A920);
+    PW64_REG(D_8034EFA0);
