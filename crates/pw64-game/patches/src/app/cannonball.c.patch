+// Quit from the pause menu: cannonFrame802D7B7C's restore of the saved
+// points, for every player (each from its own D_80359A98).
+void pw64_cannon_quit(Unk80362690* arg0) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    s32 i;
+    s32 k;
+
+    for (i = pw64_level_players - 1; i >= 0; i--) {
+        pw64_player_switch(i);
+        for (k = 0; k < 4; k++) {
+            p->unk74->unk40[p->cls].unk0[k][p->veh].unk2C = D_80359A98[k];
+            p->unk74->unk40[p->cls].unk0[k][p->veh].unk4 = 0;
+        }
+        p->test = 0;
+    }
+    D_8037DC84 = 1;
+}
