+// PW64 split-screen (splitscreen.md "Cannonball"): every player takes the
+// same shot of each round at once, from their own cannon (drawn only in
+// their own view) and scored on their own results/statics; the round ends
+// when every player's shot has landed and shown its points for 3 s
+// (cannonLandedFrame's wait). game.c.patch pw64_cannon_frame_split runs the
+// frame; the functions below run with the given player live.
+extern s32 D_8034F858; // code_9A960.c: frame counter (log only)
+void pw64_task_sync_players(void); // task.c.patch
+static u8 sPw64CbLanded;  // this round's shot has landed and is scored
+static f32 sPw64CbWait;   // game time its points stay up until
+static s32 sPw64CbPoints; // its points (TEXT_C_POINTS is one shared string)
+
+void pw64_reg_cannonball(void) {
+    PW64_REG(D_8034E9F0);
+    PW64_REG(D_8034E9F4);
+    PW64_REG(D_8034E9F8);
+    PW64_REG(D_80359A84);
+    PW64_REG(D_80359A88);
+    PW64_REG(D_80359A98);
+    PW64_REG(D_80359AA8);
+    PW64_REG(D_80359AAC);
+    PW64_REG(D_80359AB0);
+    PW64_REG(D_80359AC0);
+    PW64_REG(D_8034E9FC);
+    PW64_REG(sPw64TestTime);
+    PW64_REG(sPw64CbLanded);
+    PW64_REG(sPw64CbWait);
+    PW64_REG(sPw64CbPoints);
+}
+
+// The live player's cannon is drawn in its own view only (both cannons
+// stand on the same pillar); the pilot stays visible to everyone.
+void pw64_cannon_own(CannonballData* cbData) {
+    pw64_dobj_claim(cbData->unk54);
+    sPw64CbLanded = FALSE;
+    sPw64CbPoints = 0;
+}
+
+// Player i (live, channel/camera/results set by the caller): what
+// cannonLoad802D77D8 does for player 1's cannon at the first target.
+void pw64_cannon_load_player(Unk80362690* arg0, s32 i) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    CannonballData* cbData = (CannonballData*)p->vehicleData;
+    Mtx4F sp3C;
+    s32 k;
+
+    D_80359AAC = levelGetTotalPoints(p->unk74, p->cls, p->veh);
+    D_80359AA8 = 0;
+    for (k = 0; k < 4; k++) {
+        D_80359A98[k] = testGetPointCount(p->unk74, p->cls, k, p->veh);
+        p->unk74->unk40[p->cls].unk0[k][p->veh].unk2C = 0x7F;
+        p->unk74->unk40[p->cls].unk0[k][p->veh].unk4 = 0x7F;
+        D_80359A88[k] = 0;
+    }
+    cannonLoadLevel(i, p->pilot, cbData, p->unk70);
+    cannonLevelEnterLeave(cbData);
+    cbData->unkC = 0;
+    cbData->unkE = 0;
+    uvMat4Copy(&sp3C, &cbData->unk14);
+    uvMat4RotateAxis(&sp3C, 1.5707961f, 'x');
+    func_802EDD9C(p, &sp3C);
+    camera_802D4DE8(p->unk70, 0);
+    func_8032B508(p->unk74);
+    pw64_cannon_own(cbData);
+    D_80359A84 = 0;
+    hudWarningText(TEXT_CANON_1, 1.5f, 8.0f);
+}
+
+// The live player's part of one frame (cannonFrame802D7B7C while aiming or
+// flying, then cannonLandedFrame's scoring and fly-out camera). TRUE once
+// its shot has landed and the points have been up for 3 s.
+s32 pw64_cannon_player_frame(Unk80362690* arg0) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    CannonballData* cbData = (CannonballData*)p->vehicleData;
+    Mtx4F sp58;
+
+    if (sPw64CbLanded) {
+        cannonPilotLand(cbData);
+        return D_8034F850 >= sPw64CbWait;
+    }
+    cannonMovementFrame(cbData, arg0->state);
+    if (cbData->unkD4 != 0) {
+        uvMat4Copy(&sp58, &cbData->unk14);
+        uvMat4RotateAxis(&sp58, 1.5707961f, 'x');
+    } else {
+        uvMat4Copy(&sp58, &cbData->unk58);
+        uvMat4RotateAxis(&sp58, cbData->zAxis, 'z');
+        uvMat4RotateAxis(&sp58, cbData->xAxis, 'x');
+    }
+    func_802EDAF0(p, &sp58, cbData->unk120, cbData->unk1D0, 0.0f, 1.0f, cbData->unk4, cbData->unk8, 0, cbData->unk11C, 1);
+    if (cbData->unkD4 == 2) {
+        sPw64CbLanded = TRUE;
+        sPw64CbWait = D_8034F850 + 3.0f;
+        sPw64CbPoints = pw64_cannon_score(cbData);
+        PW64_LOGF("split-screen cannonball: landed (frame << 12 | player << 8 | points)",
+                  ((u32)D_8034F858 << 12) | (pw64_player_cur << 8) | sPw64CbPoints);
+    }
+    return FALSE;
+}
