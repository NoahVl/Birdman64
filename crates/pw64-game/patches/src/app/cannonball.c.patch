+// Before the live player's view is drawn: its own points in TEXT_C_POINTS.
+void pw64_cannon_view_text(void) {
+    if (sPw64CbLanded && (((CannonballData*)D_80362690->unkC[0].vehicleData)->unkD5 == 2)) {
+        textFmtIntAt(textGetDataByIdx(TEXT_C_POINTS), sPw64CbPoints, 2, 0);
+    }
+}
