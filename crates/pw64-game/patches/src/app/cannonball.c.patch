+// Every player's shot of the round is done (player 1 live, also on return):
+// cannonLandedFrame's end + cannonEndShot for everyone in step. The target
+// tally after its 3rd shot (player 1's, "Next": the others'), then the next
+// shot, a new target's level (loaded once, then each player's cannon), or
+// the end of all four targets.
+s32 pw64_cannon_next_round(Unk80362690* arg0) {
+    Unk80362690_Unk0* p = &arg0->unkC[0];
+    CannonballData* cbData = (CannonballData*)p->vehicleData;
+    s32 shot = cbData->unkE;
+    s32 tgt = cbData->unkC;
+    s32 i;
+
+    if ((shot == 2) && (tgt < 3)) {
+        sndSetMusic(BGM_RESULTS);
+        sndSetMusicState(MUS_STATE_PLAY_SEQ);
+        func_8033FCD0(p->veh);
+        pw64_split_viewport(p->unk70, -1); // tallies are full screen
+        resultHandler(1);
+        pw64_split_viewport(p->unk70, 0);
+    }
+    if (++shot > 2) {
+        shot = 0;
+        tgt++;
+    }
+    if (tgt >= 4) {
+        for (i = pw64_level_players - 1; i >= 0; i--) {
+            pw64_player_switch(i);
+            cbData = (CannonballData*)p->vehicleData;
+            cbData->unkE = shot;
+            cbData->unkC = tgt;
+            p->test = 0;
+            cannonEndAllTgts(cbData);
+            hudText_8031D8E0(-1, 0, 0.0f);
+            hudWarningText(-1, 0.0f, 0.0f);
+            sPw64CbLanded = FALSE;
+        }
+        pw64_split_viewport(p->unk70, -1); // the final tallies
+        PW64_LOGF("split-screen cannonball: all targets done, players", pw64_level_players);
+        return GAME_STATE_RESULTS_CB;
+    }
+    sndSetMusic(BGM_CANNONBALL);
+    sndSetMusicState(MUS_STATE_PLAY_SEQ);
+    func_8033FCD0(p->veh);
+    if (tgt != cbData->unkC) {
+        uvEventPost(0x19, 0);
+        envSoundInit();
+        taskDeinitLevel();
+        windObjDeinit();
+        proxAnimDispatchInit();
+        level_8030BA60();
+        for (i = pw64_level_players - 1; i >= 0; i--) {
+            pw64_player_switch(i);
+            cbData = (CannonballData*)p->vehicleData;
+            cbData->unkE = shot;
+            cbData->unkC = tgt;
+            p->test++;
+            cannonLevelEnterLeave(cbData);
+            cannonEndTarget(cbData);
+        }
+        taskInitTest(p->cls, p->veh, p->test, &arg0->map, &arg0->terraId, &arg0->envId);
+        levelLoad(arg0->map, p->pilot, p->veh, 1);
+        hudInit();
+        hud_8031A2CC();
+        taskLoad();
+        pw64_task_sync_players(); // player 1 live: the others' task state as at a test start
+        windObjLoad();
+        uvChanTerra(p->unk70->unk22C, arg0->terraId);
+        uvEnvFunc(arg0->envId, 0, env_802E0CF0);
+        for (i = 0; i < pw64_level_players; i++) {
+            pw64_player_switch(i);
+            cbData = (CannonballData*)p->vehicleData;
+            if (i > 0) {
+                func_8034B5E0(i, p->unk70);
+                uvChanTerra(i, arg0->terraId);
+                uvChanEnv(i, arg0->envId);
+                hudInit();
+            }
+            cannonLoadLevel(i, p->pilot, cbData, p->unk70);
+            cannonLevelEnterLeave(cbData);
+            cbData->unkE = shot;
+            cbData->unkC = tgt;
+            if (i == 0) {
+                func_8034B5E0(p->unk70->unk22C, p->unk70);
+            }
+            pw64_split_viewport(p->unk70, i);
+            pw64_cannon_own(cbData);
+        }
+    }
+    for (i = pw64_level_players - 1; i >= 0; i--) {
+        pw64_player_switch(i);
+        cbData = (CannonballData*)p->vehicleData;
+        cbData->unkE = shot;
+        cbData->unkC = tgt;
+        sPw64CbLanded = FALSE;
+        cannonLevelEnterLeave(cbData);
+        camera_802D4DE8(cbData->camera, 0);
+        switch (shot) {
+        case 0:
+            hudWarningText(TEXT_CANON_1, 1.5f, 8.0f);
+            break;
+        case 1:
+            hudWarningText(TEXT_CANON_2, 1.5f, 8.0f);
+            break;
+        case 2:
+            hudWarningText(TEXT_CANON_3, 1.5f, 8.0f);
+            break;
+        }
+    }
+    func_80313E0C(0.0f);
+    PW64_LOGF("split-screen cannonball: next shot (frame << 8 | target << 4 | shot)",
+              ((u32)D_8034F858 << 8) | (tgt << 4) | shot);
+    return GAME_STATE_TEST_UPDATE;
+}
