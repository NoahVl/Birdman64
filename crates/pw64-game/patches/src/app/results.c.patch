 #include "total_results.h"

+// PW64 split-screen (game.c.patch): whose tally is shown (0 = player 1);
+// "Next" on player 1's shows the other players' first.
+extern s32 pw64_results_player;
+void pw64_results_other_players(void);
+
+// PW64 split-screen: "PLAYER n" above the tally.
+static void pw64_results_label(void) {
+    static char sLabel[] = "PLAYER 1";
+
+    sLabel[7] = (char)('1' + pw64_results_player);
+    uvFontSet(6);
+    uvFontScale(1.0, 1.0);
+    uvFontColor(0xFA, 0xFA, 0x00, 0xFF);
+    uvFontPrintStr((SCREEN_WIDTH / 2) - (uvFontWidth(sLabel) / 2), 196, sLabel);
+}
+
+// PW64 split-screen: the shown tally's player's film (snap.c state is per
+// player, pw64_reg_snap): their photo count, and Check photo with them
+// live (their photos, vehicle and camera). Kept photos go to the album of
+// the save file (player 1's). No-ops for player 1.
+static s32 pw64_results_photo_count(void) {
+    s32 n;
+
+    pw64_player_switch(pw64_results_player);
+    n = func_8033F62C();
+    pw64_player_switch(0);
+    return n;
+}
+
+static s32 pw64_results_check_photos(void) {
+    s32 kept;
+
+    pw64_player_switch(pw64_results_player);
+    kept = func_8033E3A8(2);
+    pw64_player_switch(0);
+    return kept;
+}
+
