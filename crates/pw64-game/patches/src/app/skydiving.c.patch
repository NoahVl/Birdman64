+// Divers in the sky (terra 9) and below it (the island) are in different
+// places: each view shows the other diver only while both are in the same
+// part (owner 0 = drawn in every view).
+static void pw64_sky_owners(void) {
+    SkyDivingData* sd;
+    s32 apart = FALSE;
+    s32 j;
+
+    for (j = 1; j < pw64_level_players; j++) {
+        if ((((SkyDivingData*)D_80362748[j])->unk264 == 1.0f) != (((SkyDivingData*)D_80362748[0])->unk264 == 1.0f)) {
+            apart = TRUE;
+        }
+    }
+    for (j = 0; j < pw64_level_players; j++) {
+        sd = (SkyDivingData*)D_80362748[j];
+        if (sd->objId < ARRAY_COUNT(pw64_dobj_owner)) {
+            pw64_dobj_owner[sd->objId] = apart ? (u8)(j + 1) : 0;
+        }
+    }
+}
