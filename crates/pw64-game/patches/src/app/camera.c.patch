+// PW64 split-screen: viewport rect for player `i` of 2, top/bottom or
+// left/right (pw64_split_lr, latched at test start); a 1 px seam between.
+// N64 viewport y runs bottom-up (SUBSCREEN_Y0 is the bottom row).
+void pw64_split_viewport(void* camera, int i) {
+    Camera* cam = camera;
+    s16 mid = (SUBSCREEN_Y0 + SUBSCREEN_Y1) / 2;
+    s16 midx = (SUBSCREEN_X0 + SUBSCREEN_X1) / 2;
+    f32 w, h, aspect, out;
+    if (i < 0) { // back to one view (cameraInit's viewport and frustum)
+        cameraSetViewport(cam, SUBSCREEN_X0, SUBSCREEN_X1, SUBSCREEN_Y0, SUBSCREEN_Y1);
+        cam->clipX0 = -0.4906542f;
+        cam->clipX1 = 0.4906542f;
+        cam->clipY0 = -0.35f;
+        cam->clipY1 = 0.35f;
+        return;
+    }
+    if (pw64_split_lr) {
+        if (i == 0) {
+            cameraSetViewport(cam, SUBSCREEN_X0, midx - 1, SUBSCREEN_Y0, SUBSCREEN_Y1);
+        } else {
+            cameraSetViewport(cam, midx + 1, SUBSCREEN_X1, SUBSCREEN_Y0, SUBSCREEN_Y1);
+        }
+    } else if (i == 0) {
+        cameraSetViewport(cam, SUBSCREEN_X0, SUBSCREEN_X1, mid + 1, SUBSCREEN_Y1);
+    } else {
+        cameraSetViewport(cam, SUBSCREEN_X0, SUBSCREEN_X1, SUBSCREEN_Y0, mid - 1);
+    }
+    // Keep the frustum's shape = the shown view's: the game's 4:3 frustum
+    // is x +/-0.4906542, y +/-0.35 for the 300x214 subscreen. A wider view
+    // keeps x and shrinks y; a taller view keeps y and shrinks x. A
+    // left/right view on a wider output (widescreen or fill) is stretched
+    // by the renderer from its outer subscreen edge (x 10/310) to the
+    // output's edge (N64 x 160 -/+ 120*out): that much wider here.
+    w = cam->viewX1 - cam->viewX0;
+    h = cam->viewY1 - cam->viewY0;
+    out = pw64_split_out_aspect();
+    if (pw64_split_lr && out > 0.0f) {
+        w += 120.0f * out - (SUBSCREEN_X1 - SUBSCREEN_X0) / 2;
+    }
+    aspect = w / h;
+    if (aspect >= 0.4906542f / 0.35f) {
+        cam->clipX1 = 0.4906542f;
+        cam->clipY1 = 0.4906542f / aspect;
+    } else {
+        cam->clipY1 = 0.35f;
+        cam->clipX1 = 0.35f * aspect;
+    }
+    cam->clipX0 = -cam->clipX1;
+    cam->clipY0 = -cam->clipY1;
+}
