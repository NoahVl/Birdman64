+// PW64 split-screen: the gyro reticle's "107" (code_7CF30.c func_802F6DC8)
+// is the full view's half height, assuming HUD scale 1. The projection's
+// real half height is the uvGfxClipRect guard viewport (view +/-5 px, 58
+// rows for a top/bottom view), and pw64-gfx scales each split HUD by
+// k = min(h/214, w/300) (w with the left/right widening, as in
+// pw64_split_viewport): HUD px per NDC = guard half / k. Full view: 107.
+float pw64_split_reticle_half(void* camera) {
+    Camera* cam = camera;
+    s32 g0, g1;
+    f32 w, h, k, out;
+    if (cam->viewX0 == SUBSCREEN_X0 && cam->viewX1 == SUBSCREEN_X1 &&
+        cam->viewY0 == SUBSCREEN_Y0 && cam->viewY1 == SUBSCREEN_Y1) {
+        return 107.0f;
+    }
+    w = cam->viewX1 - cam->viewX0;
+    h = cam->viewY1 - cam->viewY0;
+    out = pw64_split_out_aspect();
+    if (pw64_split_lr && out > 0.0f) {
+        w += 120.0f * out - (SUBSCREEN_X1 - SUBSCREEN_X0) / 2;
+    }
+    k = h / (SUBSCREEN_Y1 - SUBSCREEN_Y0);
+    if (w / (SUBSCREEN_X1 - SUBSCREEN_X0) < k) {
+        k = w / (SUBSCREEN_X1 - SUBSCREEN_X0);
+    }
+    if (k > 1.0f) {
+        k = 1.0f;
+    }
+    // uvGfxClipRect's guard rows (clamped like it).
+    g0 = cam->viewY0 - 5;
+    if (g0 < 0) {
+        g0 = 0;
+    }
+    g1 = cam->viewY1 + 5;
+    if (g1 > SCREEN_HEIGHT - 1) {
+        g1 = SCREEN_HEIGHT - 1;
+    }
+    return ((g1 - g0) / 2.0f) / k;
+}
