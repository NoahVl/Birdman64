+    uvChan_80204C94(1, c1->clipX0, c1->clipX1, c1->clipY0, c1->clipY1, 1.0f, c0->clipFar);
+    uvChan_80204B34(1, &m);
+    uvChan_80204BD4(1, 1, c0->unk20);
