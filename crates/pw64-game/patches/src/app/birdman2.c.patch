     bmData->unk240 = uvVec3Len(&bmData->unk234);
 }
 
+// PW64 rate: zero-order hold of the pitch control torque (see below). Starts
+// due so the first frame computes it.
+static f32 sPw64PitchAcc = 1.0f;
+static f32 sPw64PitchTq;
+
 void bird_802CF24C(BirdmanData* bmData) {
     f32 var_fa1;
     f32 var_fa0;
@@ -256,8 +262,17 @@
         var_fa1 = bmData->unkE8 * var_fv1;
     }
 
