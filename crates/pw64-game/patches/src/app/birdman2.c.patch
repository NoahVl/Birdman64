-    temp_fv0 = uvSqrtF(SQ(bmData->unk10.m[0][0]) + SQ(bmData->unk10.m[0][1]));
+    // PW64 rate: this pitch torque switches between the stick term and a
+    // backward-airflow term on the sign of the forward airflow. In a stall the
+    // sign chatters: on the N64 each switch applied a whole frame of stick
+    // torque (overshoot -> |airflow| > 0.1 -> lift, bird_802CFAC8); at high
+    // rates it slides along 0 with no lift and a stall landing drops at the
+    // ~26 m/s terminal speed (crash). Sample-and-hold the term at REF frames.
+    if (pw64_ticks(&sPw64PitchAcc) > 0) {
+        sPw64PitchTq = -bmData->unk2B0 * 6.4f * var_fa1;
+    }
+    bmData->unk250.x += sPw64PitchTq;
+    temp_fv0 =uvSqrtF(SQ(bmData->unk10.m[0][0]) + SQ(bmData->unk10.m[0][1]));
     var_fa1 = bmData->unkE4 * (temp_fv0 * 0.9f);
 
     if (ABS_NOEQ(bmData->unk200.y) < 20.0f) {
@@ -299,7 +314,9 @@
